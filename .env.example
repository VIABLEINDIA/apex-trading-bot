# --- Kotak Neo API credentials ---
KOTAK_CONSUMER_KEY=
KOTAK_CONSUMER_SECRET=
KOTAK_MOBILE_NUMBER=
# KOTAK_PASSWORD is NOT used by the real auth flow (totp_login/totp_validate
# authenticates with UCC + TOTP + MPIN below, not the account password) --
# left here only in case a future neo_api_client version needs it. Safe to
# leave blank.
KOTAK_PASSWORD=
KOTAK_TOTP_SECRET=
KOTAK_NEO_FIN_KEY=neotrade
# Unique Client Code (your Kotak Neo trading account ID) and numeric MPIN --
# both required by the real totp_login/totp_validate auth flow, separate from
# KOTAK_PASSWORD.
KOTAK_UCC=
KOTAK_MPIN=

# --- Safety switch ---
# Bot starts in paper/dry-run mode by default. Real orders are placed ONLY when
# this is explicitly set to "true". Do not flip this until the strategy has been
# validated with LIVE_TRADING=false for several sessions.
LIVE_TRADING=false

# --- Capital & risk ---
TOTAL_CAPITAL=100000
MAX_SLOTS=10
CAPITAL_PER_SLOT_PCT=0.10
CONFIDENCE_THRESHOLD=0.55
# Portfolio-level circuit breaker: halt new entries and force-flatten every
# open position for the rest of the day once realized+unrealized PnL breaches
# -this fraction of TOTAL_CAPITAL. See README "Risk management" -- a
# per-trade stop-loss backtested *worse* than no stop-loss on this strategy,
# so this is a portfolio-level backstop instead of a per-trade one.
DAILY_LOSS_LIMIT_PCT=0.02
# Max simultaneous open positions in the same Industry (per data/nifty500.csv's
# Industry column) -- prevents e.g. 5 of the 10 slots all being correlated
# bank/finance names that move together, understating real portfolio risk.
MAX_POSITIONS_PER_SECTOR=3
# Max new positions opened within the same clock hour -- prevents piling into
# more trades right after a string of losses in a bad hour before the model's
# signals have had a chance to reflect changed conditions.
MAX_TRADES_PER_HOUR=4
# Halt new entries after this many losing trades in a row (resets daily) --
# independent of DAILY_LOSS_LIMIT_PCT, catches a "cold streak" even before
# cumulative PnL breaches the daily loss limit.
MAX_CONSECUTIVE_LOSSES=5
# Manual kill switch: create this file to block all new entries immediately
# (existing positions still exit normally); delete it to resume. Checked
# fresh on every signal evaluation, not cached.
KILL_SWITCH_PATH=./data/KILL_SWITCH

# --- Per-trade exit: ATR stop + trailing profit-lock ---
# Adapted from the BALU strategy profile. Fundamentally different from the
# fixed-% stop-loss we already tested and rejected (see README "Risk
# management") -- this is volatility-adjusted per stock and only ratchets in
# the trader's favor once activated, rather than a blanket threshold.
ATR_STOP_MULT=0.75
ATR_TRAIL_ACTIVATION_MULT=0.25
ATR_TRAIL_DISTANCE_MULT=0.12

# --- Risk-based position sizing ---
# Size each trade so a stop-out loses this fraction of TOTAL_CAPITAL, capped
# by CAPITAL_PER_SLOT_PCT as a safety ceiling (never bigger than the flat
# slot allocation, even for a very tight stop).
RISK_PER_TRADE_PCT=0.013

# --- Trading-window session gating ---
# Primary session (market open to this time): normal confidence threshold.
# Continuation session (until this time): requires threshold +
# CONTINUATION_CONFIDENCE_BONUS and trades at CONTINUATION_SIZE_MULT of normal
# size. No new entries after CONTINUATION_SESSION_END -- avoids the volatile
# close entirely (our own slippage table already shows it's the worst time to
# trade). Existing positions still flatten at day-end regardless.
PRIMARY_SESSION_END=10:15
CONTINUATION_SESSION_END=13:15
CONTINUATION_CONFIDENCE_BONUS=0.05
CONTINUATION_SIZE_MULT=0.4

# --- Universe / screener ---
SCREENER_UNIVERSE_SIZE=500
SCREENER_TOP_N=300
ROC_LOOKBACK_DAYS=30

# --- Paths ---
DB_PATH=./data/trading_journal.db
MODEL_PATH=./models/momentum_classifier.joblib
